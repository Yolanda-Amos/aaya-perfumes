# Copy this file to `.env.local` in the project root, then fill in the
# values. `.env.local` is git-ignored — never commit real keys.
#
# Every value can be left blank while you design. The site will run with
# the built-in catalogue and guest checkout, and simply skip the
# features you have not set up yet.

# --- 1. Supabase (database + Google sign-in) ---------------------
# Supabase > Project Settings > API
# You need TWO keys:
#   - the "anon / publishable" key  -> safe in the browser
#   - the "service_role / secret" key -> server only, for writing orders
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- 2. Google sign-in -------------------------------------------
# Supabase already brokers Google sign-in, so there is no Google SDK
# to install. You just paste two values from Google Cloud Console:
#   OAuth client ID  -> Supabase > Authentication > Providers > Google
#   Client secret    -> same page
# Supabase fills in the redirect URL for you; see README for the
# exact clicks.

# --- 3. Email (order confirmation) -----------------------------
# Any ONE of these providers works. The code picks whichever is set,
# Sent through Resend: https://resend.com > API Keys > Create API key
RESEND_API_KEY=
# The from address must be on a domain you have verified in Resend.
# Without one, use onboarding@resend.dev (delivers only to your own
# Resend account email).
RESEND_FROM=Aaya Perfume <orders@yourdomain.com>
# Used for the sign-in redirect and the links inside emails.
# Leave as localhost while developing; it MUST be your live domain in
# production or order emails will link back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
